    "notes": "The fed's own relaunch broadcast after a self-described two-year hibernation; the entire card builds to a Trio Ladder Match crowning a new PWF World Champion.",
    "matches": [
      {
        "order": 1,
        "sides": [
          [
            "ace-cooper-pwf"
          ],
          [
            "hardcore-machines-pwf",
