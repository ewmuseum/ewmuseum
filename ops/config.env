# ops/config.env — the ONE place the cycle learns where things are.
#
# Sourced by every script in scripts/ops/ and exported to their Python children.
# Every value is overridable from the environment: this file only fills in a
# default for a name that is not already set, so
#
#     WORKSHOP_ROOT=/mnt/collection npm run preflight
#
# wins over anything written here. Nothing in this file may be an absolute path
# to one particular machine — a fresh clone on a fresh box must work unedited.
#
# MUSEUM_ROOT   the repo itself. Derived from the calling script's own location,
#               so a clone anywhere is correct without editing this file.
# WORKSHOP_ROOT the private workshop beside the repo: raw mined material, wave
#               deltas, the privacy ledger, the fusebox state, desk/ markers.
#               Never served, never committed (docs/OPERATIONS.md, "The
#               workshop, the digests, and the repo boundary"). A clone with no
#               local collection still gates and builds; only the chain's
#               wave-apply steps need it, and they no-op when it is absent.
# SCRATCH_ROOT  per-cycle logs and intermediates. Disposable by design: losing it
#               costs a cycle's logs, never the machinery (that was the 2026-09-15
#               finding that produced these scripts).
# NODE_BIN      directory holding the node/npm to use. Empty = whatever is on PATH.

: "${MUSEUM_ROOT:?ops/config.env must be sourced by a scripts/ops script, which sets MUSEUM_ROOT}"
: "${WORKSHOP_ROOT:=$(dirname "$MUSEUM_ROOT")/archive}"
: "${SCRATCH_ROOT:=$WORKSHOP_ROOT/ops-scratch}"
: "${NODE_BIN:=}"

# 2026-09-26: prose-waves added on the main disk while the vault (the usenet collections) is emergency_ro with I/O errors;
# the epitaph programme writes there.
# Wave trees the chain's gate-free window scans for READY deltas, relative to
# WORKSHOP_ROOT. A walk that opens a new scratch year adds ONE line here — the
# 2026-09-14 finding (thirteen READY 1996 waves committed by name and never
# applied) was a glob list that lived in eight derived scripts instead of one.
WAVE_TREES="${WAVE_TREES:-}"

export MUSEUM_ROOT WORKSHOP_ROOT SCRATCH_ROOT NODE_BIN WAVE_TREES

# D290 (the Janitor, desk send 2026-10-04T17:24Z): uploads over R2's S3 API (hook c48; c47 route; read-only check passed first)
: "${R2_SYNC_TRANSPORT:=s3}"; export R2_SYNC_TRANSPORT   # D290 (2026-10-04): the chain uploads over R2's S3 API (c47)
